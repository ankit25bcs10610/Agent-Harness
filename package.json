{
  "name": "chiku",
  "version": "1.0.0",
  "description": "A terminal-based AI coding agent",
  "license": "MIT",
  "author": "Ankit Pandey",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankit25bcs10610/Agent-Harness.git"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "bun",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "chiku": "dist/chiku.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/chiku.js",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun src/index.tsx",
    "website:dev": "bun scripts/website-server.ts",
    "website:build": "bun scripts/build-website-docs.ts",
    "website:seo": "bun scripts/build-website-seo.ts",
    "watch": "bun --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "format:ci": "prettier --check src tests docs .github/workflows/ci.yml package.json",
    "build": "bun scripts/build-cli.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "package:check": "bun scripts/package-check.ts",
    "package:test": "bun tests/package-smoke.ts",
    "release:checksums": "bun scripts/checksums.ts dist/chiku.js dist/chiku.js.map",
    "release:manifest": "bun scripts/release-manifest.ts dist/chiku.js dist/chiku.js.map",
    "security:check": "bun scripts/security-check.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:intelligence": "bun scripts/benchmark-intelligence.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/typescript-estree": "^8.71.1",
    "bun-types": "^1.4.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/sdk": "^1.2.66",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  }
}
